CC = wcc
CFLAGS = -0 -ml -d0 -i=third_party\libtandy\include
LINKER = wlink
LFLAGS = system dos

all : nyancat.exe

ram.obj : src\ram.c src\ram.h
	$(CC) $(CFLAGS) src\ram.c

dma.obj : src\dma.c src\dma.h
	$(CC) $(CFLAGS) src\dma.c

irq.obj : src\irq.c src\irq.h
	$(CC) $(CFLAGS) src\irq.c

sndblast.obj : src\sndblast.c src\sndblast.h src\ram.h src\dma.h src\irq.h
	$(CC) $(CFLAGS) src\sndblast.c

wav.obj : src\wav.c src\wav.h src\ram.h src\sndblast.h
	$(CC) $(CFLAGS) src\wav.c

screen.obj : src\screen.c src\screen.h
	$(CC) $(CFLAGS) src\screen.c

tandy.obj : src\tandy.c src\tandy.h third_party\libtandy\include\lt_score.h third_party\libtandy\include\lt_audio.h third_party\libtandy\include\lt_sound.h
	$(CC) $(CFLAGS) src\tandy.c

lt_chip.obj : third_party\libtandy\src\lt_chip.c third_party\libtandy\include\lt_sound.h
	$(CC) $(CFLAGS) -fo=lt_chip.obj third_party\libtandy\src\lt_chip.c

lt_audio.obj : third_party\libtandy\src\lt_audio.c third_party\libtandy\include\lt_audio.h third_party\libtandy\include\lt_sound.h
	$(CC) $(CFLAGS) -fo=lt_audio.obj third_party\libtandy\src\lt_audio.c

lt_score.obj : third_party\libtandy\src\lt_score.c third_party\libtandy\src\lt_score_clock.h third_party\libtandy\include\lt_score.h third_party\libtandy\include\lt_audio.h third_party\libtandy\include\lt_sound.h
	$(CC) $(CFLAGS) -fo=lt_score.obj third_party\libtandy\src\lt_score.c

lt_dos.obj : third_party\libtandy\adapters\lt_dos.c third_party\libtandy\include\lt_sound.h
	$(CC) $(CFLAGS) -fo=lt_dos.obj third_party\libtandy\adapters\lt_dos.c

nyancat.obj : src\nyancat.c src\nyananim.h src\nyandata.h src\screen.h src\tandy.h third_party\libtandy\include\lt_score.h third_party\libtandy\include\lt_audio.h third_party\libtandy\include\lt_sound.h src\ram.h src\dma.h src\irq.h src\sndblast.h src\wav.h
	$(CC) $(CFLAGS) src\nyancat.c

nyancat.exe : ram.obj dma.obj irq.obj sndblast.obj wav.obj screen.obj tandy.obj lt_chip.obj lt_audio.obj lt_score.obj lt_dos.obj nyancat.obj
	$(LINKER) $(LFLAGS) name $@ file { ram.obj dma.obj irq.obj sndblast.obj wav.obj screen.obj tandy.obj lt_chip.obj lt_audio.obj lt_score.obj lt_dos.obj nyancat.obj }

clean :
	del *.obj
	del *.exe

zip:
	pkzip -Pr nyansrc.zip data\*.bmp tools\*.c tools\make*.* src\*.* make*.* *.txt
	pkzip nyancat.zip nyancat.exe nyanloop.wav *.txt
